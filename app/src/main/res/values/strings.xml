    <!-- About Screen -->
    <string name="about_title">About EasyNits</string>
    <string name="description_title">App Description</string>
    <string name="description_content">EasyNits is a brightness management tool, which includes features like \"Dynamic Nits Control\" with fast ambient light detection for responsive, smooth transitions, \"Personalized Offsets\" to manually fine-tune the brightness baseline to suit your comfort level, and \"Scheduled Time Frames\" to automatically apply specific brightness offsets for different times of the day (e.g., a dimmer display at night).</string>
    <string name="permissions_title">Permissions</string>
    <string name="permissions_content">• Write Settings: Required to adjust the system screen brightness level.\n• Post Notifications: Used to show the persistent service status when running in the background.\n• Auto Start: Ensures protection starts immediately after your device boots.</string>
    <string name="ai_usage_title">AI Usage</string>
    <string name="ai_usage_content">EasyApps is a vibe-coding project and is made with the help of AI.</string>
    <string name="credits_title">Credits &amp; Libraries</string>
