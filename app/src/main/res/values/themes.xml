<resources>
    <!-- Base application theme. -->
    <style name="Theme.EasyNits" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, widget and duration -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>

        <!-- Use the same icon as the app.
             Removing this explicitly allows it to default to the activity's launcher icon,
             which is necessary for activity-alias icon switching to reflect here. -->
        <!-- <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item> -->

        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <!-- Post-splash screen theme. -->
        <item name="postSplashScreenTheme">@style/Theme.EasyNits</item>
    </style>
</resources>