    <!-- About Screen -->
    <string name="about_title">Tentang EasyNits</string>
    <string name="description_title">Deskripsi Aplikasi</string>
    <string name="description_content">EasyNits adalah alat manajemen kecerahan, yang mencakup fitur seperti \"Kontrol Nits Dinamis\" dengan deteksi cahaya sekitar yang cepat untuk transisi yang responsif dan mulus, \"Offset Personalisasi\" untuk menyempurnakan garis dasar kecerahan secara manual sesuai tingkat kenyamanan Anda, dan \"Rentang Waktu Terjadwal\" untuk menerapkan offset kecerahan tertentu secara otomatis untuk waktu yang berbeda dalam sehari (misalnya, layar yang lebih redup di malam hari).</string>
    <string name="permissions_title">Izin</string>
    <string name="permissions_content">• Ubah Setelan: Diperlukan untuk menyesuaikan tingkat kecerahan layar sistem.\n• Notifikasi: Digunakan untuk menunjukkan status layanan persisten saat berjalan di latar belakang.\n• Mulai Otomatis: Memastikan perlindungan dimulai segera setelah perangkat Anda dihidupkan.</string>
    <string name="ai_usage_title">Penggunaan AI</string>
    <string name="ai_usage_content">EasyApps adalah proyek vibe-coding dan dibuat dengan bantuan AI.</string>
    <string name="credits_title">Kredit &amp; Pustaka</string>
    <string name="credits_content">Konsep &amp; Ikon aplikasi: Marc Napitupulu\n\n[GitHub](https://github.com/marcdroid) | [Website](https://justamarc.wordpress.com/)\n\n• [Jetpack Compose](https://developer.android.com/compose)\n• [Kotlin Coroutines](https://kotlinlang.org/docs/coroutines-overview.html)\n• [Material 3](https://m3.material.io)</string>
