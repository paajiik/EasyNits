    <!-- About Screen -->
    <string name="about_title">Acerca de EasyNits</string>
    <string name="description_title">Descripción de la aplicación</string>
    <string name="description_content">EasyNits es una herramienta de gestión de brillo que incluye funciones como el \"Control dinámico de nits\" con detección rápida de luz ambiental para transiciones suaves, \"Compensaciones personalizadas\" para ajustar manualmente la base de brillo según su comodidad, e \"Intervalos programados\" para aplicar automáticamente compensaciones de brillo específicas según la hora del día (por ejemplo, una pantalla más tenue por la noche).</string>
    <string name="permissions_title">Permisos</string>
    <string name="permissions_content">• Escribir ajustes: Necesario para ajustar el nivel de brillo del sistema.\n• Notificaciones: Se usa para mostrar el estado del servicio persistente en segundo plano.\n• Inicio automático: Garantiza que la protección comience inmediatamente después del arranque.</string>
    <string name="ai_usage_title">Uso de IA</string>
    <string name="ai_usage_content">EasyApps es un proyecto de \"vibe-coding\" realizado con la ayuda de IA.</string>
    <string name="credits_title">Créditos y bibliotecas</string>
    <string name="credits_content">Concepto e icono: Marc Napitupulu\n\n[GitHub](https://github.com/marcdroid) | [Sitio web](https://justamarc.wordpress.com/)\n\n• [Jetpack Compose](https://developer.android.com/compose)\n• [Kotlin Coroutines](https://kotlinlang.org/docs/coroutines-overview.html)\n• [Material 3](https://m3.material.io)</string>
